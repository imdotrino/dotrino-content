    "test": "node --test 'test/**/*.test.js'",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@dotrino/identity": "0.53.0",
    "@dotrino/remote-agent": "0.3.2"
  }
}
