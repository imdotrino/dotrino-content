{
  "name": "dotrino-content",
  "version": "0.3.8",
  "description": "Nodo de contenido del ecosistema Dotrino: guarda los bytes del usuario direccionados por su hash (cid), en su propia maquina y, si el dueno quiere, respaldados en su propio bucket (R2, Backblaze, Hetzner, Storj o S3). Lo publico sale por URL directa; lo privado, cifrado y solo por la red Dotrino.",
  "type": "module",
  "bin": {
    "dotrino-content": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node bin/cli.js start",
    "test": "node --test 'test/**/*.test.js'",
    "type-check": "tsc --noEmit && tsc --noEmit -p lib"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@dotrino/identity": "0.73.0",
    "@dotrino/remote-agent": "0.6.1",
    "@dotrino/vault": "0.35.0"
  },
  "keywords": [
    "dotrino",
    "content-addressed",
    "cid",
    "self-hosted",
    "privacy",
    "s3",
    "r2",
    "blob-storage"
  ],
  "homepage": "https://github.com/imdotrino/dotrino-content#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-content.git"
  },
  "bugs": {
    "url": "https://github.com/imdotrino/dotrino-content/issues"
  },
  "author": "Dotrino",
  "files": [
    "bin",
    "src",
    "lib/public.js",
    "lib/ref.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
