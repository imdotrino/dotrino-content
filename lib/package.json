{
  "name": "@dotrino/content-client",
  "version": "0.3.3",
  "description": "Cliente de navegador del pilar de contenido de Dotrino: guarda y lee los bytes del usuario en su propio content node (sesión cifrada por el vault), cifra E2E y arma la referencia compartible ownerId+cid para el #fragment y lee lo PÚBLICO de otros dueños por la red (fetchPublic).",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./ref": "./ref.js",
    "./crypto": "./crypto.js",
    "./thumb": "./thumb.js",
    "./public": "./public.js",
    "./local": "./local.js",
    "./cid": "./cid.js",
    "./session": "./session.js"
  },
  "files": [
    "cid.js",
    "crypto.js",
    "index.js",
    "local.js",
    "public.js",
    "ref.js",
    "session.js",
    "thumb.js"
  ],
  "peerDependencies": {
    "@dotrino/identity": ">=0.120.0",
    "@dotrino/remote-agent": ">=0.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/imdotrino/dotrino-content.git",
    "directory": "lib"
  },
  "homepage": "https://content.dotrino.com/",
  "keywords": [
    "dotrino",
    "content",
    "cid",
    "e2e",
    "privacy",
    "self-hosted"
  ]
}
